{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": true,
    "paths": {
      "@nexora/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*", "public/**/*"]
}
